<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <AssemblyName>AereaCo.NexusUX.FSharp</AssemblyName>
        <Version>1.0.0-beta.1</Version>
        <RootNamespace>AereaCo.NexusUX.FSharp</RootNamespace>
        <Nullable>disabled</Nullable>

        <!-- General info -->
        <Description>SDK for ServerSentEvents and convenience methods for Nexus-UX</Description>
        <Authors>Greg Holden and contributors</Authors>
        <NeutralLanguage>en-CA</NeutralLanguage>

        <!-- Build config -->
        <DebugType>embedded</DebugType>
        <OutputType>Library</OutputType>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- NuGet config -->
        <PackageId>AereaCo.NexusUX.FSharp</PackageId>
        <PackageTags>nexus-ux;nexus-ux-sharp;fsharp;functional;asp.net core;asp.net;.net core;routing;web;csharp</PackageTags>
        <PackageProjectUrl>https://github.com/aereaco/nexus-ux</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageIcon>nexus-ux_icon.png</PackageIcon>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/aereaco/nexus-ux</RepositoryUrl>

        <!-- SourceLink settings -->
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
        <IncludeSymbols>true</IncludeSymbols>
        <Title>AereaCo.NexusUX.FSharp</Title>
        <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    </PropertyGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <None Include="..\..\assets\nexus-ux_icon.png">
          <Pack>true</Pack>
          <Link>nexus-ux_icon.png</Link>
          <PackagePath>$(PackageIconUrl)</PackagePath>
        </None>
        <Content Include="..\..\README.md">
          <Link>README.md</Link>
        </Content>
        <Compile Include="Utility.fs" />
        <Compile Include="Consts.fs" />
        <Compile Include="Types.fs" />
        <Compile Include="ServerSentEventGenerator.fs" />
        <Compile Include="HttpHandlers.fs" />
    </ItemGroup>

</Project>