<template shadowrootmode="open">
    <div class="card bg-base-100 shadow-xl p-6">
                <div class="card-body" data-signals="{ x: 5, y: 10 }">
                    <h2 class="card-title">Computed Value Example</h2>
                    <p>The result field updates automatically as you type.</p>
                    
                    <div class="divider"></div>

                    <!-- Field 1 -->
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text">Input 1</span>
                        </label>
                        <input type="number" data-bind="x" class="input input-bordered w-full" />
                    </div>

                    <!-- Field 2 -->
                    <div class="form-control w-full mt-4">
                        <label class="label">
                            <span class="label-text">Input 2</span>
                        </label>
                        <input type="number" data-bind="y" class="input input-bordered w-full" />
                    </div>

                    <div class="divider">Result</div>

                    <!-- Computed Field -->
                    <div class="form-control w-full">
                        <label class="label">
                            <span class="label-text">Input 1 &times; Input 2 =</span>
                        </label>
                        <div class="p-4 border rounded-md bg-base-200 text-xl font-bold text-center">
                            <span data-text="$x * $y"></span>
                        </div>
                    </div>
                </div>
            </div>
</template>